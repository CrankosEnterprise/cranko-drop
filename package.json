{
  "name": "cranko-drop",
  "version": "1.0.2",
  "description": "Universal Download & Conversion Hub",
  "main": "dist-electron/main/index.js",
  "author": "Cranko Drop Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:electron": "tsc && vite build",
    "prepare:binaries": "node scripts/ensure-binaries.mjs",
    "pack:win": "npm run prepare:binaries && npm run build:electron && electron-builder --win --x64",
    "pack:linux": "npm run build:electron && electron-builder --linux AppImage deb",
    "start": "electron ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
